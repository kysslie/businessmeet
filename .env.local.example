# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase dashboard: Settings > API Keys (the Connect dialog also shows the first two).

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_ (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Secret key, starts with sb_secret_. Never prefix with NEXT_PUBLIC_.
# Used for account deletion (F8). Not needed until then.
SUPABASE_SECRET_KEY=
